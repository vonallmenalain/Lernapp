rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["Alain.sc2@gmail.com", "alain.sc2@gmail.com"];
    }

    function isGuestId(guestId) {
      return guestId.matches('guest_[A-Za-z0-9_-]{8,48}');
    }

    // --- Eltern und ihre Kinder ----------------------------------------------
    // Wer zu wem gehört, steht am Kind: parentUid. Geschrieben wird das Feld
    // nur vom Server (Admin-SDK) oder vom Admin – ein Konto, das sich selbst
    // eintragen dürfte, erbte den Kauf einer fremden Familie (ownerMayNotTouch).
    // Deshalb darf diese Regel sich darauf verlassen.
    //
    // Der get() kostet einen Lesevorgang je Prüfung. Das ist der Preis dafür,
    // dass die Elternschaft am Kind steht und nicht in einer zweiten Liste,
    // die mit der ersten auseinanderlaufen könnte.
    function isParentOf(userId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.get("parentUid", "") == request.auth.uid;
    }

    // Ein Konto mit Kindern ist ein Elternkonto. Gefragt wird das nur für das
    // eigene Dokument – deshalb reicht resource.data, ohne zweiten get().
    function hasChildren() {
      return resource.data.get("children", []).size() > 0;
    }

    // --- Gruppen -------------------------------------------------------------
    // Eine Gruppe ist kein eigenes Dokument, sondern ein Feld am Konto:
    // group.id sagt, wer zusammengehört. Das ist Absicht – so entscheidet eine
    // Regel über dasselbe Dokument, das sie freigibt, und niemand kann sich
    // über ein Gruppendokument Zugriff auf ein Konto verschaffen, das gar nicht
    // dazugehört.
    //
    // Geschrieben wird das Feld nur vom Admin. Ein Kind, das sich selbst in
    // eine fremde Gruppe schriebe, läse sonst fremden Fortschritt mit.
    function groupIdIn(data) {
      return data.get("group", {}).get("id", "");
    }

    function myGroupId() {
      return groupIdIn(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function groupIdOfUser(userId) {
      return groupIdIn(get(/databases/$(database)/documents/users/$(userId)).data);
    }

    // Gleiche Gruppe, und die Gruppe ist nicht die leere: ohne diese zweite
    // Bedingung läge jedes Konto ohne Gruppe mit jedem anderen ohne Gruppe in
    // derselben – nämlich in keiner.
    function sharesGroupWith(userId) {
      return isSignedIn() && groupIdOfUser(userId) != "" && groupIdOfUser(userId) == myGroupId();
    }

    // Der Admin darf einen Account zurücksetzen. Erlaubt ist dafür genau das,
    // was ein Zurücksetzen anfasst: die Gesamtzahlen, die Spielstände und die
    // Marke, an der ein Gerät des Kindes erkennt, dass es aufräumen muss. Name,
    // Rolle, Lok und Levelmodus bleiben dem Admin verwehrt – lesen darf er sie,
    // ändern nicht.
    function isProgressReset() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["stats", "gameState", "progressReset", "updatedAt"]);
    }

    // Und er darf ein Konto einer Gruppe zuordnen und den Namen ändern, unter
    // dem dessen Zug in der Gruppe steht. Auch hier nur dieses eine Feld.
    //
    // Nur er: Eine Familie bekommt ihre Gruppe vom Server (familie.mjs), aber
    // eine übergreifende Gruppe – zwei Familien, eine Klasse – legt der Admin
    // an. Ein Elternkonto, das Gruppen setzen dürfte, könnte sein Kind in eine
    // fremde Familie schreiben und läse deren Fortschritt mit.
    function isGroupChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["group", "updatedAt"]);
    }

    // --- Familie -------------------------------------------------------------
    // Ein Elternkonto (echte Adresse) legt Kinderkonten an; die Zuordnung
    // steht an beiden Enden: parentUid am Kind, children[] am Elternkonto.
    // Geschrieben wird beides vom Server, wenn er ein Kind anlegt – über das
    // Admin-SDK, an diesen Regeln vorbei –, oder vom Admin von Hand. Nie vom
    // Konto selbst: Wer sich einem fremden Elternkonto zuordnen könnte, erbte
    // dessen Kauf. Dieselbe Sperre wie bei der Gruppe, aus demselben Grund.
    function ownerMayNotTouch() {
      return ["group", "parentUid", "children", "wagonSet"];
    }

    function isFamilyChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["parentUid", "children", "updatedAt"]);
    }

    // --- Das Wagen-Set der Familie -------------------------------------------
    // config/train sagt, welches Set für alle gilt; users/<uid>.wagonSet sagt,
    // welches für dieses eine Konto gilt, und schlägt das globale, wenn es
    // neuer ist. Setzen darf das ein Elternkonto – für sich und für seine
    // Kinder – und der Admin. Nicht das Kind selbst: Ein Wechsel setzt den
    // ganzen Fortschritt auf 0, und das ist keine Entscheidung eines
    // Sechsjährigen, der einen hübscheren Wagen sieht.
    function isWagonSetChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["wagonSet", "updatedAt"]);
    }

    match /users/{userId} {
      // Wer in derselben Gruppe ist, darf das Konto lesen: Name, Lok,
      // Landschaft und die Spielstände, aus denen sein Zug gezeichnet wird.
      // Feldweise geht das in Firestore nicht – wer liest, liest das ganze
      // Dokument, also auch die Anmeldeadresse. Bei den Kinderkonten ist das
      // eine technische Adresse aus dem Namen; wer sich mit einer echten
      // Adresse anmeldet, gibt sie der Gruppe damit preis. Deshalb legt
      // Gruppen nur der Admin an, und er weiss, wen er zusammenlegt.
      allow get, list: if isOwner(userId) || isAdmin()
        || (isSignedIn() && groupIdIn(resource.data) != "" && groupIdIn(resource.data) == myGroupId());
      // Und die Eltern das Konto ihres Kindes: Der Elternbereich zeigt Namen,
      // Zug und Zahlen der eigenen Kinder. get, nicht list – die Eltern kennen
      // die Kennungen ihrer Kinder aus children[] und holen sie einzeln; eine
      // Abfrage über die ganze Kollektion bekommt niemand.
      allow get: if isParentOf(userId);
      // Das eigene Konto gehört dem Kind – bis auf die Gruppe. Wer sich selbst
      // eintragen dürfte, läse damit den Fortschritt fremder Kinder mit.
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(ownerMayNotTouch());
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerMayNotTouch());
      allow delete: if isOwner(userId);
      allow update: if isAdmin() && (isProgressReset() || isGroupChange() || isFamilyChange() || isWagonSetChange());
      // Die Eltern dürfen an ihrem Kind genau zweierlei: den Fortschritt
      // zurücksetzen und das Wagen-Set der Familie setzen. Nicht den Namen,
      // nicht die Gruppe, nicht die Elternschaft – sonst könnte ein
      // Elternkonto sein Kind in eine fremde Gruppe schreiben, und die
      // Gruppen sind Sache des Admins.
      allow update: if isParentOf(userId) && (isProgressReset() || isWagonSetChange());
      // Das eigene Wagen-Set: wagonSet steht in ownerMayNotTouch, damit kein
      // Kind es sich selbst setzt. Ein Elternkonto – erkennbar an children[],
      // das nur der Server schreibt – darf es für sich selbst.
      allow update: if isOwner(userId) && hasChildren() && isWagonSetChange();

      // Die beiden Unterkollektionen, die es gibt – und nur die. Bis hierher
      // stand hier ein rekursiver Platzhalter, match /{document=**}, und der
      // war eine Lücke: In rules_version 2 passt er auf null oder mehr
      // Pfadstücke, also auch auf das Konto selbst. Sein "write: if isOwner"
      // galt damit für users/{userId} – und weil Regeln, die etwas erlauben,
      // mit ODER verknüpft sind, gewann er über die Regel oben, die group
      // vor dem Kind schützt. Ein Kind konnte sich in jede Gruppe schreiben.
      // Geprüft wird das jetzt von scripts/test-rules.mjs.
      //
      // Gelöste Level und Sitzungen darf der Admin löschen, aber nicht
      // schreiben: Fortschritt wegräumen ja, Fortschritt erfinden nein.
      match /levelProgress/{levelId} {
        // Gelöste Level sind das, was die Gruppe voneinander sehen soll. Nur
        // lesen, und nur diese eine Unterkollektion – Sitzungen bleiben privat.
        allow read: if isOwner(userId) || isAdmin() || sharesGroupWith(userId) || isParentOf(userId);
        allow write: if isOwner(userId);
        allow delete: if isAdmin() || isParentOf(userId);
      }

      match /sessions/{sessionId} {
        // Die Sitzungen des eigenen Kindes dürfen die Eltern sehen: Im
        // Elternbereich steht, wie lange und woran es gesessen hat. Die
        // Gruppe sieht sie weiterhin nicht – eine Klasse ist keine Familie.
        allow read: if isOwner(userId) || isAdmin() || isParentOf(userId);
        allow write: if isOwner(userId);
        allow delete: if isAdmin() || isParentOf(userId);
      }
    }

    // --- Der Kauf --------------------------------------------------------------
    // Wer bezahlt hat, steht in entitlements/{uid}. Geschrieben wird das nur
    // vom Server: nach einer Zahlung bei Stripe, über das Admin-SDK und damit
    // an diesen Regeln vorbei – für das Elternkonto und für jedes seiner
    // Kinder. Kein Client schreibt hier, auch der Admin nicht von Hand: Sonst
    // wäre die Schranke nur so gut wie das Passwort eines Kontos. Lesen darf
    // jedes Konto seinen eigenen Stand, und der Admin alle.
    //
    // Konten ohne Eintrag hier sind nicht gesperrt, sondern frei, sofern sie
    // von vor dem Kauf stammen: Ob ein Konto ein Kinderprofil eines
    // Elternkontos ist (parentUid) oder ein Konto aus der Zeit davor,
    // entscheidet der Client. Das ist bewusst keine Regel: Die Level liegen
    // ohnehin in der App, die Schranke ist eine für Eltern, nicht für Hacker.
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // --- Die Post ------------------------------------------------------------
    // Jede Mail, die Gripszug verschickt hat, und jede, die an kids@alae.app
    // ankam: der Reiter E-Mail im Adminbereich. Geschrieben wird hier nur vom
    // Server (netlify/functions/_lib/mail.mjs, über das Admin-SDK und damit an
    // diesen Regeln vorbei) – von keinem Client, auch nicht vom Admin.
    //
    // Warum nicht einmal er: In diesen Dokumenten steht, was verschickt wurde
    // und was ankam. Ein Postausgang, in dem sich Einträge nachträglich ändern
    // lassen, beweist nichts mehr – und die eine Frage, für die es ihn gibt,
    // ist ja gerade "ist das rausgegangen?".
    //
    // Lesen darf nur der Admin: Hier stehen fremde Adressen und fremder Text.
    match /mails/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Wohin eingehende Post weitergeleitet wird. Steht bewusst NICHT in
    // config/, obwohl es dazu passte: config/ darf jeder lesen (ein Gast muss
    // das Wagen-Set erfahren), und eine private Adresse geht niemanden etwas
    // an. Geschrieben wird auch das nur vom Server – er prüft die Adresse,
    // bevor sie dasteht (/api/mail-einstellungen).
    match /mailConfig/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Das Wagen-Set -----------------------------------------------------
    // Ein einziges Dokument für alle: config/train sagt, welches Wagen-Set
    // gilt und wann zuletzt gewechselt wurde. Lesen darf jeder, auch ohne
    // Konto – ein Gast muss den Wechsel genauso erfahren wie ein Kind mit
    // Konto. Schreiben darf nur der Admin.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guests/{guestId} {
      allow get, list: if isAdmin();
      allow create, update: if !isSignedIn()
        && isGuestId(guestId)
        && request.resource.data.type == "guest";
      allow delete: if false;

      match /levelProgress/{levelId} {
        allow read: if isAdmin();
        allow create, update: if !isSignedIn() && isGuestId(guestId);
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow read: if isAdmin();
        allow create, update: if !isSignedIn() && isGuestId(guestId);
        allow delete: if false;
      }

      // Kein rekursiver Platzhalter, aus demselben Grund wie bei users: Er
      // passte auch auf das Gastdokument selbst. Hier stand zwar write: false,
      // aber read: isAdmin() – und was einmal zu weit passt, passt beim
      // nächsten Umbau zu weit an einer Stelle, die es dann schmerzt.
    }

    // Alles andere ist gesperrt. Dieser Platzhalter auf oberster Ebene ist
    // der einzige, der bleiben darf: er verbietet nur.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
